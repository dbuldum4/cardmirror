{
  "name": "@cardmirror-advanced/desktop",
  "version": "2.0.0",
  "description": "CardMirror Advanced \u2014 Electron desktop wrapper",
  "author": "Anthony Trufanov",
  "homepage": "https://github.com/dbuldum4/cardmirror-advanced",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:service": "node scripts/build-file-index-service.cjs",
    "build": "tsc -p tsconfig.json",
    "build:renderer": "npm --prefix ../.. run build -- --base=./",
    "start:web": "npm --prefix ../.. run dev",
    "start:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "npm run build:native && npm run build:main && npm run build:service && concurrently --kill-others-on-fail --names \"vite,electron\" --prefix-colors \"cyan,magenta\" \"npm:start:web\" \"npm:start:electron\"",
    "build:native": "node scripts/build-ax-suppress.cjs",
    "pack": "npm run fetch:koffi-cross && npm run build:native && npm run build:renderer && npm run build:main && npm run build:service && electron-builder --dir",
    "dist": "npm run fetch:koffi-cross && npm run build:native && npm run build:renderer && npm run build:main && npm run build:service && electron-builder",
    "release": "npm run check:release-runtime && npm run fetch:koffi-cross && npm run build:native && npm run build:renderer && npm run build:main && npm run build:service && electron-builder --publish always",
    "fetch:koffi-cross": "bash scripts/fetch-koffi-cross.sh",
    "pack:lite": "node scripts/inject-lite-build.cjs 1 && VITE_LITE=1 npm run pack -- -c.productName=\"CardMirror Advanced Lite\" -c.appId=io.github.dbuldum4.cardmirror-advanced.lite -c.executableName=\"CardMirror Advanced Lite\"; node scripts/inject-lite-build.cjs 0",
    "dist:lite": "node scripts/inject-lite-build.cjs 1 && VITE_LITE=1 npm run dist -- -c.appId=io.github.dbuldum4.cardmirror-advanced.lite -c.productName=\"CardMirror Advanced Lite\" -c.mac.artifactName=\"CardMirror-Advanced-Lite-${version}-${arch}.${ext}\" -c.win.artifactName=\"CardMirror-Advanced-Lite-Setup-${version}.${ext}\" -c.linux.artifactName=\"cardmirror-advanced-lite-${version}.${ext}\" -c.executableName=\"CardMirror Advanced Lite\" -c.linux.executableName=cardmirror-advanced-lite; node scripts/inject-lite-build.cjs 0",
    "check:runtime": "node scripts/check-electron-runtime.cjs",
    "check:release-runtime": "node scripts/check-electron-runtime.cjs --require-patched-node"
  },
  "build": {
    "appId": "io.github.dbuldum4.cardmirror-advanced",
    "productName": "CardMirror Advanced",
    "executableName": "cardmirror-advanced",
    "electronVersion": "45.0.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/voice/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "../../dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/new-template.cmir",
        "to": "new-template.cmir"
      },
      {
        "from": "resources/native",
        "to": "native"
      },
      {
        "from": "resources/flow",
        "to": "flow"
      },
      {
        "from": "build/docx.ico",
        "to": "docx.ico"
      }
    ],
    "fileAssociations": [
      {
        "ext": "cmir",
        "name": "CardMirror Advanced Document",
        "description": "CardMirror-compatible native document",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSAppSleepDisabled": true,
        "NSMicrophoneUsageDescription": "CardMirror Advanced uses the microphone for optional voice control and dictation."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "x64ArchFiles": "**/node_modules/@koromix/**"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "maintainer": "CardMirror Advanced contributors",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "cardmirror-advanced-${version}.${ext}"
    },
    "pacman": {
      "depends": [
        "c-ares",
        "ffmpeg",
        "gtk3",
        "libevent",
        "libnotify",
        "libvpx",
        "libxslt",
        "libxss",
        "minizip",
        "nss",
        "re2",
        "snappy",
        "libxcrypt-compat"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "dbuldum4",
      "repo": "cardmirror-advanced"
    },
    "afterSign": "scripts/sign-mac.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "koffi": "^3.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "sherpa-onnx-node": "1.13.7",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbuldum4/cardmirror-advanced.git"
  },
  "bugs": {
    "url": "https://github.com/dbuldum4/cardmirror-advanced/issues"
  },
  "overrides": {
    "sprintf-js": "file:vendor/sprintf-js"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
